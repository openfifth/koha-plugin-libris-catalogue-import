[% USE raw %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% FILTER collapse %]
    [% t("Libris Catalogue Import") | html %] &rsaquo;
    [% t("Koha") | html %]
[% END %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_LibrisCatalogueImport_tool" class="plugins">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active = 1 %]
            <span>Libris Catalogue Import</span>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-10 order-md-2 order-sm-1">
            <main>
                <h1>Libris Catalogue Import</h1>

                [% IF run_result %]
                    [% IF run_result.outcome == 'success' %]
                        <div class="alert alert-success">Import run finished: [% run_result.num_records | html %] records staged[% IF run_result.batch_id %] in <a href="/cgi-bin/koha/tools/manage-marc-import.pl?import_batch_id=[% run_result.batch_id | uri %]">batch [% run_result.batch_id | html %]</a>[% END %], [% run_result.num_deleted | html %] deleted.</div>
                    [% ELSIF run_result.outcome == 'partial' %]
                        <div class="alert alert-warning">Import run finished with problems: <pre>[% run_result.error_message | html %]</pre></div>
                    [% ELSE %]
                        <div class="alert alert-danger"><strong>Import run failed:</strong> [% run_result.error_message | html %]</div>
                    [% END %]
                [% END %]

                [% IF !configured %]
                    <div class="alert alert-info">Not configured yet. <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=configure">Configure the plugin</a> to start importing.</div>
                [% ELSE %]
                    <p>Runs nightly with Koha's plugin cron job.[% IF last_until %] Records changed up to <strong>[% last_until | html %]</strong> have been fetched.[% END %]</p>
                    <form method="post">
                        [% INCLUDE 'csrf-token.inc' %]
                        <input type="hidden" name="class" value="[% CLASS %]"/>
                        <input type="hidden" name="method" value="tool"/>
                        <input type="hidden" name="run_now" value="1"/>
                        <input type="submit" class="btn btn-primary" value="Run now"/>
                        <a class="btn btn-default" href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS %]&method=configure">Configure</a>
                    </form>
                [% END %]

                <h2>Recent runs</h2>
                [% IF runs.size %]
                    <table class="table table-striped">
                        <thead><tr><th>Started</th><th>From</th><th>Until</th><th>Outcome</th><th>Records</th><th>Deleted</th><th>Batch</th><th>Notes</th></tr></thead>
                        <tbody>
                        [% FOREACH r IN runs %]
                            <tr>
                                <td>[% r.started_on | html %]</td>
                                <td>[% r.from_ts | html %]</td>
                                <td>[% r.until_ts | html %]</td>
                                <td>[% r.outcome | html %]</td>
                                <td>[% r.num_records | html %]</td>
                                <td>[% r.num_deleted | html %]</td>
                                <td>[% IF r.batch_id %]<a href="/cgi-bin/koha/tools/manage-marc-import.pl?import_batch_id=[% r.batch_id | uri %]">[% r.batch_id | html %]</a>[% END %]</td>
                                <td>[% r.error_message | html %]</td>
                            </tr>
                        [% END %]
                        </tbody>
                    </table>
                [% ELSE %]
                    <p>No runs yet.</p>
                [% END %]
            </main>
        </div>
        <div class="col-md-2 order-sm-2 order-md-1">
            <aside>[% INCLUDE 'tools-menu.inc' %]</aside>
        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
